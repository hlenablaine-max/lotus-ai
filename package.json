{
  "name": "lotus-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "cd apps/web && pnpm prisma generate",
    "db:migrate": "cd apps/web && pnpm prisma migrate dev",
    "db:push": "cd apps/web && pnpm prisma db push",
    "db:studio": "cd apps/web && pnpm prisma studio",
    "app": "pnpm --filter @lotus/desktop start"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}