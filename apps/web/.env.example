# ============================================================
# LOTUS AI — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# --- Banco de Dados (PostgreSQL) ---
# Para produção: Vercel Postgres ou Neon.tech (free tier)
# Para dev local: postgresql://USER:PASS@localhost:5432/lotus_ai
DATABASE_URL=postgresql://user:password@host:5432/lotus_ai?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/lotus_ai?sslmode=require

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-uma-chave-aqui-com-openssl-rand-base64-32

# --- AI Engine (Anthropic) ---
# Obtenha em: console.anthropic.com
DRAEL_API_KEY=sk-ant-api03-...

# --- HQ Real-time SSE ---
HQ_SSE_ENABLED=true
