# ============================================================
# LOTUS AI — Variáveis de Ambiente
# Copie este arquivo para apps/web/.env.local e preencha os valores.
# Nunca envie o .env.local para o git.
# ============================================================

# --- Banco de dados (PostgreSQL / Neon) ---
# Use os MESMOS valores em todos os computadores (o seu e o do sócio):
# é o banco compartilhado que faz os dois verem os mesmos clientes e missões.
DATABASE_URL=postgresql://user:password@host:5432/lotus_ai?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/lotus_ai?sslmode=require

# --- Login ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32
# Conta de quem usa ESTE computador
OWNER_EMAIL=voce@exemplo.com
OWNER_PASSWORD=defina-uma-senha-forte
OWNER_NAME=Seu Nome
# Opcional: segunda conta no mesmo computador
# PARTNER_EMAIL=socio@exemplo.com
# PARTNER_PASSWORD=defina-uma-senha-forte
# PARTNER_NAME=Nome do Sócio

# --- Inteligência artificial ---
# Drael é o provedor padrão. ChatGPT e Claude podem ser configurados aqui
# ou pela tela Configurações > Inteligência Artificial.
DRAEL_API_KEY=
DRAEL_BASE_URL=https://drael.sh/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
