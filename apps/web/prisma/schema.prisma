// LOTUS AI Enterprise Ã¢â‚¬â€ Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

// Seed configurado em package.json: pnpm db:seed

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  approvals     Approval[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

// ============================================================
// CLIENTS
// ============================================================

model Client {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  segment     String?
  website     String?
  instagram   String?
  description String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contacts         ClientContact[]
  missions         Mission[]
  documents        Document[]
  memories         Memory[]
  activityLogs     ActivityLog[]
  clientSolutions  ClientSolution[]
  assessments      ClientAssessment[]
  salesCalls       SalesCall[]
  leads            Lead[]
  monthlyNumbers   ClientMonthlyNumbers[]
  whatsapp         WhatsappChannel?
  manychat         ManychatAccount?
  conversations    Conversation[]
  patients         Patient[]

  @@map("clients")
}

// ============================================================
// CRM DO CLIENTE — leads, funil e resultados
// ============================================================
model Lead {
  id             String     @id @default(cuid())
  clientId       String
  name           String
  phone          String?
  email          String?
  source         LeadSource @default(OUTRO)
  campaign       String?    // campanha/anúncio de origem
  interest       String?    // serviço/tratamento de interesse
  stage          LeadStage  @default(NOVO)
  value          Float?     // valor fechado (R$)
  lostReason     String?
  notes          String?
  viaLotus       Boolean    @default(true) // veio por ação da LOTUS (anúncio, site, campanha)?
  conversationId String?    // conversa de WhatsApp que gerou o lead
  channel        String     @default("whatsapp") // por onde o lead conversa: whatsapp | instagram
  patientId      String?
  appointmentAt  DateTime?  // data e hora da consulta marcada
  quotedValue    Float?     // valor do orçamento passado
  firstContactAt DateTime?
  stageChangedAt DateTime   @default(now())
  closedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, stage])
  @@index([clientId, phone])
  @@index([appointmentAt])
  @@map("leads")
}

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  SITE
  INSTAGRAM
  WHATSAPP
  INDICACAO
  REATIVACAO
  GOOGLE_MAPS
  PACIENTE_BASE // paciente antigo da clínica que voltou a falar sozinho
  OUTRO
}

// WhatsApp da clínica ligado à LOTUS (aparelho conectado pelo QR code no app de PC)
model WhatsappChannel {
  id          String    @id @default(cuid())
  clientId    String    @unique
  phone       String?   // número conectado (só dígitos)
  displayName String?
  status      String    @default("desconectado") // desconectado | conectado
  connectedAt DateTime?
  lastEventAt DateTime?
  links       Json?     // links rastreados: [{ id, label, source, campaign, text }]
  settings    Json?     // automações (lembrete, avaliação, retorno, orçamento, aniversário) e horário de envio
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("whatsapp_channels")
}

model Conversation {
  id              String     @id @default(cuid())
  clientId        String
  jid             String     // endereço do contato no WhatsApp
  phone           String?    // só dígitos, quando conhecido
  name            String?
  source          LeadSource @default(OUTRO)
  sourceBy        String?    // como a origem foi descoberta: saudacao | base | campanha | manual
  linkId          String?    // link rastreado que trouxe o contato
  campaign        String?
  leadId          String?    // lead aberto desta conversa
  patientId       String?
  fromHistory     Boolean    @default(false) // veio do histórico do celular ao conectar (não é lead novo)
  firstMessageAt  DateTime
  lastMessageAt   DateTime
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  firstResponseAt DateTime?  // primeira resposta da clínica depois do primeiro contato
  firstResponseMin Float?    // minutos até a primeira resposta
  unread          Int        @default(0)
  lastPreview     String?
  aiHint          String?    // leitura da IA: quente/morno/frio e próximo passo
  aiDraft         String?    // resposta que a IA escreveu e espera aprovação (modo rascunho)
  aiDraftAction   String?    // o que fazer ao enviar o rascunho: "agendar:<ISO>" | "humano:<motivo>"
  aiPausedUntil   DateTime?  // a IA não responde até esta hora (um humano assumiu a conversa)
  prospectId      String?    // conversa com uma clínica prospectada pela LOTUS
  channel         String     @default("whatsapp") // whatsapp | instagram
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]

  @@unique([clientId, jid])
  @@index([clientId, lastMessageAt])
  @@index([clientId, phone])
  @@map("conversations")
}

model WhatsappMessage {
  id             String   @id @default(cuid())
  conversationId String
  clientId       String
  waId           String
  direction      String   // IN (paciente) | OUT (clínica)
  body           String
  kind           String   @default("texto")
  sentBy         String?  // paciente | clinica (pelo celular) | lotus (pelo app) | automacao
  sentAt         DateTime
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([clientId, waId])
  @@index([conversationId, sentAt])
  @@index([clientId, sentAt])
  @@map("whatsapp_messages")
}

// Base de pacientes da clínica (importada ou criada pelos fechamentos) com o histórico de compras (LTV)
model Patient {
  id           String     @id @default(cuid())
  clientId     String
  name         String
  phone        String?    // só dígitos com DDD
  email        String?
  birthDate    DateTime?
  firstVisitAt DateTime?
  lastVisitAt  DateTime?
  totalSpent   Float      @default(0)
  visits       Int        @default(0)
  lastProcedure String?
  source       LeadSource?
  origin       String     @default("base") // base (já era da clínica) | lotus (chegou pela LOTUS)
  referredById String?    // paciente que indicou
  referralCode String?    // código pessoal de indicação
  tags         String?
  notes        String?
  optOut       Boolean    @default(false) // pediu para não receber mensagens
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([clientId, phone])
  @@index([clientId, lastVisitAt])
  @@unique([clientId, referralCode])
  @@map("patients")
}

model Purchase {
  id        String   @id @default(cuid())
  clientId  String
  patientId String
  date      DateTime
  value     Float
  procedure String?
  leadId    String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([patientId])
  @@map("purchases")
}

// Instagram da clínica ligado pela conta do ManyChat (parceiro oficial da Meta): DMs entram no Atendimento
model ManychatAccount {
  id           String    @id @default(cuid())
  clientId     String    @unique
  apiKeyEnc    String    // chave da API do ManyChat, criptografada
  pageName     String?
  igUsername   String?
  inboundToken String    @unique // segredo do endereço que recebe as mensagens
  status       String    @default("conectado")
  lastEventAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("manychat_accounts")
}

// Mensagens que chegaram pela internet (ManyChat, formulários) enquanto o app estava fechado: o app processa ao abrir
model InboundEvent {
  id          String    @id @default(cuid())
  source      String    // manychat | formulario
  token       String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@map("inbound_events")
}

// Avisos para o Ícaro dentro do app (sino e notificação do Windows): alguém respondeu, a IA agendou, pediram humano...
model AppNotification {
  id        String    @id @default(cuid())
  kind      String    // resposta | agendou | humano | prospect | relatorio | sistema
  title     String
  body      String
  href      String?
  clientId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("app_notifications")
}

// Clínicas encontradas pela prospecção da LOTUS (Google Maps), com o gargalo e a abordagem personalizada
model Prospect {
  id             String    @id @default(cuid())
  campaign       String    // ex.: "Odontologia em Feira de Santana — 20/11"
  name           String
  phone          String?   // só dígitos com 55
  site           String?
  instagram      String?
  followers      Int?      // seguidores no Instagram
  lastPostDays   Int?      // há quantos dias foi o último post
  siteUrl        String?   // site grátis que a LOTUS preparou para a clínica
  siteMissionId  String?   // missão que está montando o site grátis
  ownerContact   String?   // contato do dono/responsável conseguido na conversa
  address        String?
  rating         Float?
  reviews        Int?
  category       String?
  score          Int       @default(0) // 0 a 100: quanto a clínica precisa da LOTUS
  gargalos       Json?     // lista de problemas encontrados
  message        String?   // primeira mensagem personalizada (para aprovar)
  status         String    @default("APROVAR") // APROVAR | NA_FILA | ENVIADO | RESPONDEU | CONVERSANDO | CALL_MARCADA | SEM_INTERESSE | DESCARTADO | SEM_WHATSAPP
  conversationId String?
  sentAt         DateTime?
  repliedAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@map("prospects")
}

// Fila de mensagens que a LOTUS vai mandar pelo WhatsApp da clínica (lembretes, campanhas, respostas)
model OutboundMessage {
  id             String    @id @default(cuid())
  clientId       String
  phone          String?
  jid            String?
  body           String
  kind           String    // manual | lembrete_1d | lembrete_2h | avaliacao | orcamento | retorno | reativacao | aniversario | indicacao
  refId          String?   // lead ou paciente de origem (evita mandar duas vezes)
  campaignId     String?
  status         String    @default("PENDENTE") // PENDENTE | ENVIADO | FALHOU | CANCELADO
  scheduledFor   DateTime  @default(now())
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([kind, refId])
  @@index([status, scheduledFor])
  @@index([clientId, createdAt])
  @@map("whatsapp_outbox")
}

enum LeadStage {
  NOVO
  EM_CONTATO
  AGENDADO
  COMPARECEU
  FECHADO
  PERDIDO
}

// Números do mês que só o cliente sabe (base de pacientes, investimento, faturamento total)
model ClientMonthlyNumbers {
  id           String   @id @default(cuid())
  clientId     String
  month        String   // AAAA-MM
  patientBase  Int?     // pacientes/clientes na base
  adSpend      Float?   // investimento em anúncios no mês (R$)
  revenue      Float?   // faturamento total do mês (R$)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month])
  @@map("client_monthly_numbers")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  role      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
  PROSPECT
}

// ============================================================
// AGENTS
// ============================================================

model Agent {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  title            String
  department       String
  specialty        String
  description      String?
  avatar           String?       // URL to avatar image
  model            String        @default("claude-sonnet-4-5")
  provider         AIProvider    @default(ANTHROPIC)
  systemPrompt     String
  tools            Json?
  permissions      Json?
  knowledgeBase    String?
  status           AgentStatus   @default(IDLE)
  isActive         Boolean       @default(true)
  autonomyLevel    Int           @default(1) // 1=supervised, 2=conditional, 3=requires_approval

  // Performance metrics
  tasksCompleted   Int           @default(0)
  tasksTotal       Int           @default(0)
  avgQualityScore  Float?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tasks            Task[]
  memories         Memory[]
  activityLogs     ActivityLog[]
  assessmentsCreated ClientAssessment[]

  @@map("agents")
}

enum AgentStatus {
  IDLE
  AVAILABLE
  PLANNING
  RESEARCHING
  WRITING
  DESIGNING
  CODING
  EXECUTING
  REVIEWING
  IN_MEETING
  IN_CALL
  WAITING_APPROVAL
  BLOCKED
  COMPLETED
  OFFLINE
  ERROR
}

enum AIProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  GROQ
  CUSTOM
}

// ============================================================
// MISSIONS
// ============================================================

model Mission {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  description String
  objective   String
  priority    Priority      @default(MEDIUM)
  status      MissionStatus @default(PENDING)
  type        MissionType   @default(GROWTH)

  // Context
  context     Json?         // Additional data passed to agents

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  tasks       Task[]
  documents   Document[]
  approvals   Approval[]
  memories    Memory[]
  activityLogs ActivityLog[]
  clientSolutions ClientSolution[]

  @@map("missions")
}

enum MissionType {
  GROWTH
  TRANSFORMATION
  INTELLIGENCE
  HYBRID
  INTERNAL
}

enum MissionStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_APPROVAL
  IN_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id           String     @id @default(cuid())
  missionId    String
  agentId      String?
  title        String
  description  String
  instructions String

  // Input/Output
  input        Json?
  output       Json?

  // Execution
  status       TaskStatus @default(PENDING)
  retryCount   Int        @default(0)
  maxRetries   Int        @default(3)

  // Dependencies
  dependsOn    Json? // Task IDs this task depends on

  // Timing
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  mission      Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agent        Agent?     @relation(fields: [agentId], references: [id])
  documents    Document[]
  activityLogs ActivityLog[]

  @@map("tasks")
}

enum TaskStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  WAITING_DEPENDENCY
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id         String       @id @default(cuid())
  clientId   String?
  missionId  String?
  taskId     String?

  title      String
  type       DocumentType
  content    String
  metadata   Json?
  version    Int          @default(1)

  // Audit
  status     DocStatus    @default(DRAFT)
  auditedBy  String?      // Agent ID that audited
  auditNotes String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  client     Client?      @relation(fields: [clientId], references: [id])
  mission    Mission?     @relation(fields: [missionId], references: [id])
  task       Task?        @relation(fields: [taskId], references: [id])

  @@map("documents")
}

enum DocumentType {
  RESEARCH_REPORT
  STRATEGY
  COPY
  CAMPAIGN_STRUCTURE
  CREATIVE_BRIEF
  PROPOSAL
  ANALYSIS
  AUDIT_REPORT
  MEETING_NOTES
  DELIVERABLE
  OTHER
}

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  DELIVERED
}

// ============================================================
// MEMORY Ã¢â‚¬â€ Persistent context per scope
// ============================================================

model Memory {
  id        String     @id @default(cuid())
  scope     MemoryScope

  // Scope references (one must be set based on scope)
  clientId  String?
  missionId String?
  agentId   String?

  key       String     // e.g., "competitor_analysis", "client_preferences"
  content   String
  metadata  Json?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id])
  mission   Mission?   @relation(fields: [missionId], references: [id])
  agent     Agent?     @relation(fields: [agentId], references: [id])

  @@unique([scope, clientId, missionId, agentId, key])
  @@map("memories")
}

enum MemoryScope {
  GLOBAL       // Company-wide institutional memory
  CLIENT       // Per-client context
  MISSION      // Per-mission context
  AGENT        // Per-agent operational memory
  DEPARTMENT   // Per-department knowledge
}

// ============================================================
// APPROVALS Ã¢â‚¬â€ Human approval required actions
// ============================================================

model Approval {
  id          String         @id @default(cuid())
  missionId   String?
  requestedBy String         // Agent ID

  type        ApprovalType
  title       String
  description String
  payload     Json           // The action to approve

  status      ApprovalStatus @default(PENDING)
  decidedBy   String?        // User ID
  decisionNote String?

  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  mission     Mission?       @relation(fields: [missionId], references: [id])
  user        User?          @relation(fields: [decidedBy], references: [id])

  @@map("approvals")
}

enum ApprovalType {
  PUBLISH_CAMPAIGN
  SPEND_BUDGET
  SEND_EXTERNAL_MESSAGE
  CREATE_AGENT
  GRANT_PERMISSION
  EXTERNAL_ACTION
  IMPLEMENT_IN_PRODUCTION
  SEND_PROPOSAL
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ============================================================
// CHAT Ã¢â‚¬â€ CEO Chat messages
// ============================================================

model ChatMessage {
  id        String      @id @default(cuid())
  role      ChatRole
  content   String
  metadata  Json?       // agent info, mission references, etc.

  clientId  String?     // If the conversation is about a specific client
  missionId String?     // If linked to a mission

  createdAt DateTime    @default(now())

  @@map("chat_messages")
}

enum ChatRole {
  USER       // The owner (Icaro)
  ASSISTANT  // Root Master / LOTUS AI
  SYSTEM
}

// ============================================================
// ACTIVITY LOGS Ã¢â‚¬â€ Full audit trail
// ============================================================

model ActivityLog {
  id        String   @id @default(cuid())

  // Actor
  userId    String?
  agentId   String?

  // Context
  clientId  String?
  missionId String?
  taskId    String?

  action    String
  details   Json?
  level     LogLevel @default(INFO)

  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  agent     Agent?   @relation(fields: [agentId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])
  mission   Mission? @relation(fields: [missionId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])

  @@map("activity_logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

// ============================================================
// INTEGRATIONS
// ============================================================

model Integration {
  id          String            @id @default(cuid())
  name        String
  type        IntegrationType
  status      IntegrationStatus @default(DISCONNECTED)
  config      Json?             // Non-sensitive config
  lastSyncAt  DateTime?
  errorMessage String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("integrations")
}

enum IntegrationType {
  ANTHROPIC
  OPENAI
  GOOGLE_AI
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  ANALYTICS
  CRM
  WHATSAPP
  IMAGE_GENERATION
  VIDEO_GENERATION
  BROWSER_AUTOMATION
  CUSTOM
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

// ============================================================
// SOLUTION INTELLIGENCE CATALOG
// ============================================================

model Solution {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  description         String
  problemSolved       String
  category            String
  complexity          SolutionComplexity
  features            Json?
  components          Json?
  requiredDepartments Json?
  minHours            Int                 @default(10)
  maxHours            Int                 @default(40)
  baseSetupPrice      Float             @default(0)
  baseMonthlyPrice    Float             @default(0)
  deliveryWeeks       Int                 @default(4)
  implementationModel ImplementationModel @default(TURNKEY)
  templateProposal    String?
  templateSOW         String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  clientSolutions ClientSolution[]

  @@map("solutions")
}

model ClientSolution {
  id                 String               @id @default(cuid())
  clientId           String
  solutionId         String
  missionId          String?
  status             ClientSolutionStatus @default(PROPOSED)
  customScope        String?
  quotedSetupPrice   Float?
  quotedMonthlyPrice Float?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  solution Solution  @relation(fields: [solutionId], references: [id])
  mission  Mission?  @relation(fields: [missionId], references: [id])

  @@map("client_solutions")
}

enum SolutionComplexity {
  LOW
  MEDIUM
  HIGH
  ENTERPRISE
}

enum ImplementationModel {
  TURNKEY
  CO_IMPLEMENTATION
  MAINTENANCE
}

enum ClientSolutionStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// CLIENT VALUE ASSESSMENT
// ============================================================

model ClientAssessment {
  id                      String   @id @default(cuid())
  clientId                String
  createdByAgentId        String?

  complexityScore         Int      @default(0)
  valueScore              Int      @default(0)
  effortScore             Int      @default(0)
  riskScore               Int      @default(0)

  estimatedTotalHours     Int      @default(0)
  estimatedToolsCost      Float  @default(0)
  recommendedSetupPrice   Float  @default(0)
  recommendedMonthlyPrice Float  @default(0)
  estimatedMonthlyROI     Float  @default(0)
  paybackMonths           Int      @default(0)

  pricingRationale        String
  reasoning               String
  factors                 Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  Agent?  @relation(fields: [createdByAgentId], references: [id])

  @@map("client_assessments")
}

// ============================================================
// LIVE SALES COPILOT
// ============================================================

model SalesCall {
  id              String          @id @default(cuid())
  clientId        String
  title           String
  platform        MeetingPlatform @default(OTHER)
  externalMeetingId String?
  startedAt       DateTime?
  endedAt         DateTime?
  transcript      String?
  participants    Json?
  summary         String?
  keyInsights     Json?
  suggestionsCount Int            @default(0)
  status          SalesCallStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  suggestions CallSuggestion[]

  @@map("sales_calls")
}

model CallSuggestion {
  id             String   @id @default(cuid())
  callId         String
  triggerText    String
  suggestion     String
  suggestionType String
  confidence     Float    @default(0.8)
  wasUsed        Boolean  @default(false)
  createdAt      DateTime @default(now())

  call SalesCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_suggestions")
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  TEAMS
  MANUAL
  OTHER
}

enum SalesCallStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}



